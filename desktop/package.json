{
  "name": "weeklyreport-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "周报填写检查 Windows 客户端",
  "author": "Burnside999",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "dist:win": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "playwright": "1.62.1"
  },
  "build": {
    "appId": "city.images.weeklyreport",
    "productName": "WeeklyReport",
    "artifactName": "WeeklyReport-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "*.cjs",
      "ui/**/*",
      "assets/**/*",
      "package.json",
      "!tests/**/*"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "executableName": "WeeklyReport"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "周报填写检查",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052",
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
