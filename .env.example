# Required: initial admin account password, at least 12 characters.
ADMIN_PASSWORD=change-this-password
PORT=8080
BIND_ADDRESS=0.0.0.0
# true when accessed through an HTTPS reverse proxy; false for direct HTTP.
COOKIE_SECURE=false
SESSION_HOURS=24


# Enable on the independent HTTPS test server only. Key persists in /data.
WEB_PUSH_ENABLED=false
VAPID_SUBJECT=
